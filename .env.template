# =============================================================================
# CoStaff — Agent Template Configuration
# =============================================================================
# Instructions:
#   1. Copy this file to .env  →  cp .env.template .env
#   2. Rename TEMPLATE_ prefixes to match your agent name (e.g. MYAGENT_)
#   3. Fill in all [REQUIRED] fields
#   4. Pick one option under AI Model
# =============================================================================


# -----------------------------------------------------------------------------
# AI MODEL  [REQUIRED — pick one provider]
# -----------------------------------------------------------------------------

# Active provider: "gemini" or "litellm"
COSTAFF_AGENT_MODEL_PROVIDER=gemini

# -- Option A: Google Gemini (default) ---------------------------------------
GOOGLE_API_KEY=
# TODO: Rename to your agent's model env var (e.g. MYAGENT_MODEL)
TEMPLATE_AGENT_MODEL=gemini-2.5-flash

# -- Option B: LiteLLM -------------------------------------------------------
# Only fill these if COSTAFF_AGENT_MODEL_PROVIDER=litellm
LITELLM_API_BASE=
LITELLM_API_KEY=
LITELLM_MODEL_NAME=
